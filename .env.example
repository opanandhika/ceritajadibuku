# KONFIGURASI PROTOTIPE LOKAL TAHAP 1.
# Tidak perlu menyalin/mengisi file ini untuk menjalankan demo.
# Validator startup membaca APP_ENV, empat *_PROVIDER, dan ENABLE_TESTER_GRANTS.
# Variabel layanan di bagian bawah masih rancangan tahap selanjutnya.
# APP_ENV: development | staging | production; terpisah dari NODE_ENV.
APP_ENV=development
# Simulasi hanya untuk development dengan data sintetis.
# Production wajib menolak mock/tester saat startup, bukan lewat query browser.
DATA_PROVIDER=mock
AI_PROVIDER=mock
PAYMENT_PROVIDER=mock
EMAIL_PROVIDER=mock
ENABLE_TESTER_GRANTS=false

# Supabase: belum dikonfigurasi. Publishable key hanya bersama RLS yang teruji.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=

# AI: kandidat model mengikuti blueprint, validasi akun/model pada Tahap 6.
# Kosong sampai adapter nyata dan anggaran kegagalan siap.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_TRANSCRIPTION_MODEL=
AI_ACCOUNT_FAILURE_BUDGET_IDR=
AI_GLOBAL_FAILURE_BUDGET_IDR=

# Duitku: URL dan format autentikasi diverifikasi ketika integrasi Tahap 9.
DUITKU_ENV=sandbox
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_CALLBACK_URL=
DUITKU_RETURN_URL=

# Email aplikasi (kandidat Resend); SMTP Auth dikonfigurasi terpisah.
RESEND_API_KEY=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Worker/penjadwal dan perlindungan pemetaan privat; server saja.
CRON_SECRET=
IDENTITY_ENCRYPTION_KEY=
